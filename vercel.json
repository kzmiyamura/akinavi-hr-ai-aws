{
  "//": "buildCommand から tsc -b を外すと型エラーが本番に出る（2026-09-12 に発覚）。外さないこと。",
  "buildCommand": "tsc -b && vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/analyze.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/docs/(.*)", "destination": "/docs/$1" },
    { "source": "/((?!docs/|assets/).*)", "destination": "/" }
  ]
}
